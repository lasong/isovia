# Postgres. On Heroku this is provided by the Heroku Postgres add-on — read the
# config var directly, never hardcode it, because Heroku rotates the credentials.
# Heroku Postgres requires SSL, hence sslmode=require.
#
# The app MUST be created in the EU region so the app and database sit in
# Ireland, as the privacy policy states:  heroku create <name> --region eu
# Note that Heroku still handles Postgres backups and Logplex logs in the US;
# the privacy policy discloses this.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"

# Brevo (French; personal data stored in the EU). The sending domain
# (isovia.eu) must be authenticated in Brevo with the SPF/DKIM DNS records it
# provides, or the sender must be a Brevo-validated address, before mail is
# accepted. Key: Brevo dashboard -> SMTP & API -> API keys.
BREVO_API_KEY="xkeysib-..."

# Where contact-form notifications are delivered. Comma-separated for several
# inboxes — every address receives the same notification.
CONTACT_RECIPIENT_EMAIL="operations@isovia.eu,Alain.mugabo@posteo.net"

# Envelope sender. Must be a Brevo-authenticated domain or validated sender.
CONTACT_SENDER_EMAIL="website@isovia.eu"
CONTACT_SENDER_NAME="ISOVIA Website"

# Absolute origin, used for canonical URLs, hreflang alternates and OG tags.
NEXT_PUBLIC_SITE_URL="https://isovia.eu"
